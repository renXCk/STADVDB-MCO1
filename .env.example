# Copy to .env.local for local runs. On Vercel, add the same names under Project > Settings > Environment Variables.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=mco1_schema
# Set to 1 when the host requires SSL (most cloud MySQL services do)
DB_SSL=1
# CA certificate (PEM) when the host's certificate is not publicly trusted, e.g. Aiven's ca.pem.
# On Vercel paste the whole file as the value; in a .env file put it on one line with \n between lines.
DB_SSL_CA=
